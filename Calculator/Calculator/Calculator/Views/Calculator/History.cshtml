@model IEnumerable<Calculator.Data.DataInputVariant>

@{
    ViewData["Title"] = "История расчетов";
}

<h2>История расчетов</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Первое число</th>
            <th>Второе число</th>
            <th>Операция</th>
            <th>Результат</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ID_DataInputVariant</td>
                <td>@item.Operand_1</td>
                <td>@item.Operand_2</td>
                <td>@item.Type_operation</td>
                <td>@item.Result</td>
            </tr>
        }
    </tbody>
</table>